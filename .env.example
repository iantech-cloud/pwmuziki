DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# Daraja STK Push
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain/payments/mpesa/callback/
MPESA_ACCOUNT_REFERENCE=AuraCity

# Gmail SMTP (use a 16-character Google App Password, never your normal password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=AuraCity <your-gmail-address@gmail.com>
SERVER_EMAIL=your-gmail-address@gmail.com
SITE_URL=https://your-public-domain
